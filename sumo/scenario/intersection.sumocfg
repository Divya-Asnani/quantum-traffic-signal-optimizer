<configuration>

    <input>
        <net-file value="intersection.net.xml"/>
        <route-files value="../routes/traffic.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="120"/>
    </time>

    <processing>
        <time-to-teleport value="-1"/>
    </processing>

    <report>
        <verbose value="true"/>
        <duration-log.statistics value="true"/>
    </report>

</configuration>